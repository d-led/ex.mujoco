# The NIF, on Windows, with MSVC and nmake — the toolchain an Elixir install on
# Windows already needs, and the one Fine's own example uses.
#
# `mix` runs this with MIX_APP_PATH, ERTS_INCLUDE_DIR and FINE_INCLUDE_DIR set,
# and with MUJOCO_DIR pointing at a MuJoCo prepared by
# scripts/prepare_mujoco.exs. The MuJoCo release ships `lib\mujoco.lib` to link
# against and `bin\mujoco.dll` to load; the NIF and the DLL sit together in priv,
# which is searched because OTP loads NIFs with LOAD_WITH_ALTERED_SEARCH_PATH.

PRIV_DIR=$(MIX_APP_PATH)\priv
NIF_PATH=$(PRIV_DIR)\ex_mujoco_nif.dll

C_SRC=$(EX_MUJOCO_PROJECT_DIR)\c_src
SCRIPT=$(EX_MUJOCO_PROJECT_DIR)\scripts\prepare_mujoco.exs

CPPFLAGS=/LD /std:c++17 /W4 /WX /EHsc /O2
CPPFLAGS=$(CPPFLAGS) /I"$(ERTS_INCLUDE_DIR)" /I"$(FINE_INCLUDE_DIR)"
CPPFLAGS=$(CPPFLAGS) /I"$(MUJOCO_DIR)\include" /I"$(C_SRC)"

LDFLAGS=/link /LIBPATH:"$(MUJOCO_DIR)\lib" mujoco.lib

SOURCES=$(C_SRC)\*.cpp
FINE_HEADERS=$(FINE_INCLUDE_DIR)\*.hpp

all: mujoco $(NIF_PATH)

mujoco:
	@ elixir "$(SCRIPT)" --ensure --priv "$(PRIV_DIR)"

$(NIF_PATH): $(SOURCES) $(FINE_HEADERS)
	@ if not exist "$(PRIV_DIR)" mkdir "$(PRIV_DIR)"
	cl $(CPPFLAGS) $(SOURCES) $(LDFLAGS) /Fe"$(NIF_PATH)"

clean:
	@ if exist "$(NIF_PATH)" del /q "$(NIF_PATH)"
